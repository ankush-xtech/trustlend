# ---------------------------------------------------------------------------
# TrustLend environment configuration. Copy to .env (local) and fill in values.
# NEVER commit real secrets. In production use Vercel environment variables.
# ---------------------------------------------------------------------------

# development | test | staging | production  (production enables strict config validation)
APP_ENV=development
# Public base URL (used in email links). Must be https in production.
APP_URL=http://localhost:3000

# --- Database (Neon PostgreSQL in production) --------------------------------
# Local: `npm run db:local` starts PostgreSQL on port 54320.
# Neon: use the POOLED connection string here (…-pooler…neon.tech, sslmode=require).
DATABASE_URL=postgres://postgres:postgres@localhost:54320/trustlend
# Neon: the DIRECT (non-pooled) connection string, used for migrations.
DATABASE_URL_DIRECT=
# pg = TCP via node-postgres (works with Neon pooled/direct endpoints); neon = Neon serverless driver (WebSocket)
DATABASE_DRIVER=pg
DATABASE_POOL_MAX=5

# --- Sessions / authentication ------------------------------------------------
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_HOURS=24
REQUIRE_EMAIL_VERIFICATION=true

# --- Email ---------------------------------------------------------------------
# dev = writes emails to DEV_MAILBOX_DIR and shows them at /dev/mailbox (never delivered; refused when APP_ENV=production)
# resend = delivers through Resend (https://resend.com)
EMAIL_PROVIDER=dev
EMAIL_FROM="TrustLend <no-reply@example.com>"
RESEND_API_KEY=
DEV_MAILBOX_DIR=.dev-mailbox

# --- Private document storage ---------------------------------------------------
# local = private folder outside /public (development only); s3 = Amazon S3 or S3-compatible (R2, MinIO…)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.private-storage
S3_BUCKET=
S3_REGION=
# Optional for S3-compatible providers (e.g. https://<account>.r2.cloudflarestorage.com)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=60
MAX_UPLOAD_MB=10

# --- Malware scanning ------------------------------------------------------------
# none = files stay NOT_SCANNED (reviewers see a warning; enable "require clean scan" in settings to block)
# signature = built-in EICAR/known-signature check (development stand-in only; refused in production)
# clamav = clamd INSTREAM over TCP
MALWARE_SCANNER=signature
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Background jobs ----------------------------------------------------------------
# Bearer secret for /api/jobs/* (Vercel Cron sends it automatically as CRON_SECRET). >= 32 chars in production.
CRON_SECRET=

# --- Logging ------------------------------------------------------------------------
LOG_LEVEL=info
TRUST_PROXY_HEADERS=true
